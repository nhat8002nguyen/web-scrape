# CapSolver API Key (required)
CAPSOLVER_API_KEY=your_capsolver_api_key_here

# Proxy Provider API Key (optional - for Webshare or Smartproxy)
PROXY_API_KEY=your_proxy_api_key_here

# Database credentials (for production)
POSTGRES_USER=formbot
POSTGRES_PASSWORD=formbot123
POSTGRES_DB=form_submissions

# AWS Configuration (for deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Kafka Configuration (leave as default for local Docker)
KAFKA_BROKERS=localhost:9092

# Redis Configuration
REDIS_HOST=localhost:6379

# Monitoring
PROMETHEUS_PORT=9090
METRICS_PORT=8080

# Budget Settings
CAPTCHA_BUDGET_USD=30.0
