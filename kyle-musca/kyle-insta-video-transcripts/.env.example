# Profile to crawl (local/producer). Username or reels URL. Not needed for redis worker.
# INSTAGRAM_TARGET=some.account

# Optional notifications
SIMPLEPUSH_KEY=
SIMPLEPUSH_EVENT=
SIMPLEPUSH_TITLE=Instagram transcripts

# Optional: path to browser cookie export (EditThisCookie JSON). Do not commit this file.
COOKIES_JSON=cookies.json

# Optional Instagram session reuse (session filename used by Instaloader)
INSTALOADER_SESSIONFILE=

# Instagram account that created the session (instaloader -l YOUR_ACCOUNT)—not the profile you scrape
INSTALOADER_SESSION_USERNAME=nathan.ng5844

# Optional Instagram login if you cannot use a session file (prefer session on a clean IP)
INSTAGRAM_LOGIN_USER=
INSTAGRAM_PASSWORD=

# Webshare rotating residential proxy credentials
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_PROXY_PORT=80

# Ignore Webshare / TRANSCRIPT_PROXY for Instaloader and downloads: 1/true/yes/on
# TRANSCRIPT_NO_PROXY=1
# Video file downloads use host direct IP by default (saves Webshare bandwidth). Set 0 to use proxy.
DIRECT_INSTAGRAM_DOWNLOADS=1

# Optional Hugging Face token: pyannote diarization and Whisper Hub downloads (also set HF_TOKEN if you prefer the official name).
HUGGINGFACE_TOKEN=
HF_TOKEN=
# Skip pyannote diarization (use all Whisper segments): 1/true/yes/on
DISABLE_DIARIZATION=1

# Stop after N consecutive job failures; 0 = no limit (default: 12)
# MAX_CONSECUTIVE_ERRORS=0

# Optional Redis for horizontal scaling (--redis-mode producer | worker | requeue-skipped)
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_STREAM=insta:reel:jobs
# REDIS_GROUP=transcribers
# REDIS_MODE=local    # or: producer | worker | requeue-skipped
# Worker: exit after N seconds with no jobs (optional; CLI: --redis-idle-exit-seconds)
# REDIS_IDLE_EXIT_SECONDS=600
# Worker: Simplepush when idle N seconds; worker keeps running (needs SIMPLEPUSH_KEY; CLI: --redis-idle-notify-seconds)
# REDIS_IDLE_NOTIFY_SECONDS=1800
