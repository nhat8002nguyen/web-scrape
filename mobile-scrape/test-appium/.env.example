# Appium server URL (local or remote)
APPIUM_URL=http://127.0.0.1:4723

# Path to capabilities JSON (relative to project root)
CAPABILITIES_PATH=config/capabilities.android.json

# Optional overrides (leave empty to use capabilities file values)
ANDROID_DEVICE_NAME=
APP_PACKAGE=
APP_ACTIVITY=

# Scraper defaults
SCROLL_PAUSE_SEC=1.0
MAX_STALE_SCROLLS=5
CHECKPOINT_PATH=output/checkpoint.json
